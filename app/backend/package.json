{
  "name": "iac-panel-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "db:migrate": "node-pg-migrate up --migrations-dir ../database/migrations --migrations-table pgmigrations --database-url-var MIGRATION_DATABASE_URL"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "node-pg-migrate": "9.0.0",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
