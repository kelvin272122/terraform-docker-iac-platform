APP_ENV=dev
APP_VERSION=0.1.0
PORT=3000

# Credenciales de aplicación: sin privilegios administrativos ni DDL.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=iac_panel
DB_USER=iac_app
DB_PASSWORD=replace-me

# Solo para la operación administrativa de migración. No la recibe la API.
MIGRATION_DATABASE_URL=postgresql://migration_user:replace-me@postgres:5432/iac_panel
